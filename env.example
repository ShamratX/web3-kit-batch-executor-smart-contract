# Copy this file to .env and fill in your values.
# Never commit .env — it is listed in .gitignore.

# Deployer wallet private key (without 0x prefix)
PRIVATE_KEY=

# RPC endpoints
ETH_SEPOLIA_RPC_URL=
ETH_MAINNET_RPC_URL=
BSC_MAINNET_RPC_URL=
BSC_TESTNET_RPC_URL=

# Block explorer API keys (for contract verification)
BSCSCAN_API_KEY=
# ETHERSCAN_API_KEY=

# BatchExecutor deploy setting (default: 200)
MAX_RECIPIENTS=200
